{
  // Cloudflare Workers 배포 설정 (@opennextjs/cloudflare). main·assets는 빌드 결과 경로라 바꾸지 않는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opp-skin-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // 캐시 재검증 등에서 자기 자신을 부를 때 쓴다. name과 같아야 한다.
    { "binding": "WORKER_SELF_REFERENCE", "service": "opp-skin-frontend" }
  ],
  "observability": { "enabled": true }
  // 도메인(opp.skin 또는 app.opp.skin)은 정해지면 Cloudflare 대시보드 Workers > 설정 > 도메인에서 연결한다.
}
