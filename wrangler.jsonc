{
  // Cloudflare Workers 배포 설정 (@opennextjs/cloudflare). main·assets는 빌드 결과 경로라 바꾸지 않는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opp-skin-frontend",
  // 팀 Cloudflare 계정 (opp.skin 도메인이 있는 계정)
  "account_id": "58cfee7df17af72779c13724e0594ad2",
  // opp.skin에 연결. DNS가 같은 계정 Cloudflare라 레코드·인증서는 자동으로 만들어진다.
  "routes": [{ "pattern": "opp.skin", "custom_domain": true }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // 캐시 재검증 등에서 자기 자신을 부를 때 쓴다. name과 같아야 한다.
    { "binding": "WORKER_SELF_REFERENCE", "service": "opp-skin-frontend" }
  ],
  "observability": { "enabled": true }
}
